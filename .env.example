# Explicit modes only: mock or meta. No automatic fallback.
FIELDFIX_PROVIDER=mock
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low
FIELDFIX_DB=.data/fieldfix.sqlite
FIELDFIX_LIVE_REQUEST_LIMIT=30
FIELDFIX_ENABLE_DEMO=true
# Local-only MVP: start on 127.0.0.1 with one worker.
