# Explicit modes only: mock or meta. No automatic fallback.
FIELDFIX_PROVIDER=mock
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=low
FIELDFIX_DB=.data/fieldfix.sqlite
FIELDFIX_LIVE_REQUEST_LIMIT=30
FIELDFIX_ENABLE_DEMO=true
# Optional authenticated live hosting; keep a strong private access code local.
FIELDFIX_DEMO_ACCESS_CODE=
# Set to the exact HTTPS tunnel origin only when using a hosted factory.
FIELDFIX_PUBLIC_ORIGIN=
# Explicit opt-in to code-free judging sessions (still quota/budget controlled).
FIELDFIX_PUBLIC_LIVE=false
# Local-only MVP: start on 127.0.0.1 with one worker.
